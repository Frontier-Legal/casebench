---
/**
 * A screenshot of the workbench, by its file name in `src/assets/screens/`, framed as a window, with a caption and a
 * link to the full-size image. A name with no file fails the build.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** The file name without `.png`, such as `review-answer`. */
	name: string;
	alt: string;
	caption?: string;
	/** `window` draws the browser frame; `plain` is for a crop of one panel or dialog. */
	frame?: 'window' | 'plain';
	/** The widest the image is shown, in CSS pixels. */
	width?: number;
}

const screens = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const { name, alt, caption, frame = 'window', width = 1280 } = Astro.props;
const found = screens[`../assets/screens/${name}.png`];
if (!found) throw new Error(`no screenshot named ${name} in src/assets/screens/`);
const image = found.default;
const shown = Math.min(width, Math.round(image.width / 2));
---

<figure class:list={['screenshot not-content', frame]} style={`--shot-width: ${shown}px`}>
	{
		frame === 'window' && (
			<div class="bar" aria-hidden="true">
				<span />
				<span />
				<span />
			</div>
		)
	}
	<a href={image.src} class="full" aria-label={`Open the full-size screenshot: ${alt}`}>
		<Image
			src={image}
			alt={alt}
			width={shown}
			widths={[Math.round(shown / 2), shown, Math.min(image.width, shown * 2)]}
			sizes={`(max-width: 50rem) 100vw, ${shown}px`}
			loading="lazy"
			decoding="async"
		/>
	</a>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.screenshot {
		margin: 1.75rem 0;
		max-width: var(--shot-width);
		border: 1px solid var(--cb-border);
		border-radius: var(--cb-radius-lg);
		background: var(--cb-surface);
		overflow: hidden;
		box-shadow: 0 18px 40px -28px hsla(230, 50%, 20%, 0.45);
	}

	.screenshot.plain {
		border-radius: var(--cb-radius);
	}

	.bar {
		display: flex;
		gap: 0.35rem;
		padding: 0.55rem 0.75rem;
		border-bottom: 1px solid var(--cb-border);
		background: var(--cb-surface-raised);
	}

	.bar span {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--cb-ink-5);
	}

	.full {
		display: block;
		line-height: 0;
		cursor: zoom-in;
	}

	.full:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		padding: 0.6rem 0.9rem 0.75rem;
		border-top: 1px solid var(--cb-border);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
</style>
